# Frontend Configuration
FRONTEND_ORIGIN=https://cancer-research-pulse.vercel.app

# Database Configuration (Aiven MySQL)
DATABASE_URL=mysql://username:password@host:port/database?ssl-mode=REQUIRED
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=18421
DB_USER=avnadmin
DB_PASSWORD=your_database_password
DB_NAME=defaultdb
DB_SSL=true
DB_CONNECTION_LIMIT=15

# Email Configuration (Legacy - for local development)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_gmail_app_password

# SendGrid Email Service (Production - Recommended)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your-verified-email@gmail.com

# Admin Credentials
ADMIN_USER=pulse_testing_for_nhs
ADMIN_PASS=pulse@testing@nhs

# Server Configuration
PORT=5000
